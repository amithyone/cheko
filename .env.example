# Environment (copy to .env — do not commit secrets)

# Rails API (Phase 2)
# VITE_API_BASE_URL=https://api.cheko.check-outnow.com/api/v1

# Local Checkout Broadcast bridge (Electron / Python sidecar)
# VITE_BROADCAST_BRIDGE_URL=http://127.0.0.1:8765
# VITE_HARDWARE_BRIDGE=electron

# Electron desktop build (set automatically by npm run build:desktop)
# ELECTRON=true

# Electron main process (Windows POS)
# CHEKO_TERMINAL_ID=CP-1RK8Z
# CHEKO_MERCHANT_ID=MCH-CP-1RK8Z
# CHEKO_API_KEY=bk_...
# CHEKO_SIGNING_KEY=your-broadcast-signing-key
# CHEKO_PRINTER_NAME=XP-80C
# CHEKO_SCALE_PORT=COM3
# CHEKO_BROADCAST_PYTHON=.venv/Scripts/python.exe
# CHEKO_BROADCAST_TRANSPORT=simulated
# CHEKO_BROADCAST_TRANSPORT=ble
# CHEKO_SIGNING_KEY=your-terminal-signing-key-min-16-chars
# CHEKO_SIGNATURE_ALG=ed25519
# CHEKO_BROADCAST_CONNECTIVITY=online
# Offline mode only — settlement saved on POS for BLE:
# CHEKO_SETTLEMENT_ACCOUNT=1000004863
# CHEKO_SETTLEMENT_BANK_CODE=090175
# CHEKO_MERCHANT_BANK=RUBIES MFB
# CHEKO_SETTLEMENT_ACCOUNT_NAME=MIDAS AGRO
# CHEKO_BANK_API_URL=https://api.yourbank.ng/checkout

# Optional: disable Vite HMR in constrained environments
# DISABLE_HMR=true
